# The one connection string. In production this is Neon's pooled endpoint, the hostname with
# -pooler in it, because a serverless function opens a connection per invocation.
DATABASE_URL=postgres://papsee:papsee@localhost:5432/papsee

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The host this instance is reached at, without a scheme. Canonical links, the sitemap and robots.txt
# are built from it. On Vercel it is read from the platform instead and can stay empty.
SITE_DOMAIN=

# Where the footer sends someone who wants the source. Point it at your own fork if you change the code:
# the AGPL asks a modified network version to offer its own source, not the one it was forked from.
NEXT_PUBLIC_SOURCE_URL=https://github.com/mr-blithe/papsee

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The analytics kill switch. Only the exact word true turns PostHog on, and only in a production
# build: a development run and the test suite report nothing whatever this is set to.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

SMTP_SERVER=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_FROM=
ADMIN_EMAIL=
