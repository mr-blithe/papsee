# The connection string the application runs on. In production this is the pooled endpoint, the
# hostname with -pooler in it on Neon, because a serverless function opens a connection per invocation
# and a direct endpoint runs out of them.
DATABASE_URL=postgres://papsee:papsee@localhost:5432/papsee

# The same database, reached directly. Only needed when DATABASE_URL goes through a connection pooler,
# on a provider like Neon or on a PgBouncer of your own: drizzle-kit reads this one instead, because
# schema migrations need session state transaction pooling does not keep. Leave it empty when
# DATABASE_URL already reaches Postgres directly, which is the case for the local docker compose.
DATABASE_URL_UNPOOLED=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The host this instance is reached at, without a scheme. Canonical links, the sitemap and robots.txt
# are built from it. On Vercel it is read from the platform instead and can stay empty.
SITE_DOMAIN=

# Where the footer sends someone who wants the source. Point it at your own fork if you change the code:
# the AGPL asks a modified network version to offer its own source, not the one it was forked from.
NEXT_PUBLIC_SOURCE_URL=https://github.com/mr-blithe/papsee

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# The analytics kill switch. Only the exact word true turns PostHog on, and only in a production
# build: a development run and the test suite report nothing whatever this is set to.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# The mailbox PapSee sends from. Without these five an account is usable the moment it is created:
# no address is confirmed and a sign in from an unrecognised browser is never challenged for a code.
# Leaving them empty is supported, but a real deployment should fill them in.
SMTP_SERVER=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_FROM=

# Where the contact form delivers. Only the contact form reads this; account mail goes to the reader.
# Nothing to do with the admin panel: who is an admin is the role column, set by pnpm db:promote-admin.
ADMIN_EMAIL=
